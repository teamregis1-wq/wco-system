# Copy to frontend/.env.local for LOCAL two-terminal development only
# (next dev on :3000 + uvicorn on :8000):
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# On Vercel (frontend + backend as Services on one domain) leave this UNSET
# (or set it to /api/v1): the browser then calls the same-origin /api/v1 route.
# Also leave it unset/commented when using `vercel dev`.
