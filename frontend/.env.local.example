# Copy to frontend/.env.local for LOCAL development (next dev on :3000 + uvicorn on :8000):
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Production (Vercel, backend on Railway) — set ONE of these in Vercel's Environment Variables:
#   NEXT_PUBLIC_API_BASE=https://<your-backend>.up.railway.app/api/v1
#       browser calls Railway directly; Railway's CORS_ORIGINS must include the Vercel URL.
#   BACKEND_URL=https://<your-backend>.up.railway.app
#       (and NO NEXT_PUBLIC_API_BASE) browser calls /api/v1 on the Vercel site, which proxies to Railway.
# Both are read at build time: redeploy after changing them.
