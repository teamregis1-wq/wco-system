# Copy to backend/.env and fill in. NEVER commit backend/.env. All values are placeholders.
# Supabase → your project → "Connect" → copy the pooler strings (not the direct db.<ref> host,
# which is IPv6-only).

# ── Required ────────────────────────────────────────────────────────────────
# Local machine, retraining worker, Alembic migrations: SESSION pooler (port 5432).
# On Vercel set DATABASE_URL to the TRANSACTION pooler (port 6543) instead — see docs/DEPLOYMENT_VERCEL.md.
# postgresql:// is accepted (rewritten to postgresql+psycopg://). Percent-encode special
# characters in the password (@ → %40, # → %23, / → %2F, % → %25).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres

# 32+ random characters:  python -c "import secrets; print(secrets.token_hex(32))"
# Use the SAME value everywhere the API runs (local, Vercel); changing it signs everyone out.
JWT_SECRET=<generate-a-random-64-char-hex-string>

# Comma-separated browser origins allowed by CORS (localhost for dev; your Vercel URL in production).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Optional (defaults shown) ───────────────────────────────────────────────
# WORKER_DATABASE_URL=                    # Session-pooler URL for scripts/retrain_worker.py when
#                                         # DATABASE_URL is the transaction pooler (Vercel/Daemon)
# DB_SSLMODE=require                      # applied to non-local hosts unless the URL sets sslmode
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# APP_ENV=development
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# ALLOW_PUBLIC_REGISTRATION=true          # self-registration always creates viewers

# Provenance applied to new records that don't state one. Use "synthetic" for the defense demo.
# DEFAULT_DATA_SOURCE=unspecified

# Automatic batch retraining
# AUTO_RETRAIN_ENABLED=true
# RETRAIN_EXECUTOR=                       # "inprocess" | "worker"; empty = worker on Vercel, else inprocess
# RETRAIN_DEBOUNCE_SECONDS=20             # coalescing window for bursts of edits
# RETRAIN_POLL_SECONDS=30                 # in-process safety-net poll (0 = off)
# RETRAIN_MAX_ATTEMPTS=3                  # automatic retries of transient failures
# WORKER_POLL_SECONDS=5
# WORKER_HEARTBEAT_SECONDS=15
# MODEL_ARTIFACT_DIR=                     # local model cache; the database holds the durable copy
# ML_BUNDLED_FALLBACK=true                # serve the bundled pre-audit model until the first training
# ML_RANDOM_SEED=42
# ML_MAX_EPOCHS=80
# ML_PATIENCE=8
# ML_TEST_WEEKS=16                        # held-out evaluation weeks (>= 13 for the backtest)
# ML_VAL_WEEKS=6                          # early-stopping weeks before the test period
# ML_MIN_HISTORY_WEEKS=12                 # weeks of history (span) needed to forecast
# ML_MIN_OBSERVED_WEEKS=8                 # of the last 12 weeks, how many must have a record

# GIS
# GIS_BAND_M=1500                         # Gi* distance band in metres (see ML doc §9)

# Routing
# OSRM_BASE_URL=https://router.project-osrm.org   # public demo server: fair use, no SLA
# OSRM_TIMEOUT_SECONDS=12
# ROUTE_AVG_SPEED_KMH=30

# Study-area bounding box for coordinate validation
# STUDY_AREA_LAT_MIN=13.2
# STUDY_AREA_LAT_MAX=14.4
# STUDY_AREA_LNG_MIN=120.3
# STUDY_AREA_LNG_MAX=121.8
