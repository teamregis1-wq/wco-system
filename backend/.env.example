# Copy to backend/.env and fill in. NEVER commit backend/.env.
# All values below are placeholders.

# ── Required ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Session pooler".
# The scheme may be postgresql:// (it is rewritten to postgresql+psycopg://).
# Percent-encode special characters in the password (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 32+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it signs everyone out.
JWT_SECRET=<generate-a-random-64-char-hex-string>

# Comma-separated frontend origins allowed by CORS (add your Vercel URL in production).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Optional (defaults shown) ───────────────────────────────────────────────
# APP_ENV=development
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# ALLOW_PUBLIC_REGISTRATION=true          # self-registration always creates viewers

# Provenance applied to new records that don't state one. Use "synthetic" for the defense demo.
# DEFAULT_DATA_SOURCE=unspecified

# Automatic batch retraining
# AUTO_RETRAIN_ENABLED=true
# RETRAIN_DEBOUNCE_SECONDS=20             # coalescing window for bursts of edits
# RETRAIN_POLL_SECONDS=30                 # safety-net check for queued jobs (0 = off)
# MODEL_ARTIFACT_DIR=                     # local cache dir; DB holds the durable copy
# ML_RANDOM_SEED=42
# ML_MAX_EPOCHS=80
# ML_PATIENCE=8
# ML_TEST_WEEKS=16                        # held-out evaluation weeks (≥ 13 for the backtest)
# ML_VAL_WEEKS=6                          # early-stopping weeks before the test period
# ML_MIN_HISTORY_WEEKS=12                 # consecutive weeks needed to forecast

# Routing
# OSRM_BASE_URL=https://router.project-osrm.org   # public demo server: fair use, no SLA
# OSRM_TIMEOUT_SECONDS=12
# ROUTE_AVG_SPEED_KMH=30

# Study-area bounding box for coordinate validation
# STUDY_AREA_LAT_MIN=13.2
# STUDY_AREA_LAT_MAX=14.4
# STUDY_AREA_LNG_MIN=120.3
# STUDY_AREA_LNG_MAX=121.8
